# PostgreSQL database name
POSTGRES_DB=digi2

# PostgreSQL username
POSTGRES_USER=digi2_user

# PostgreSQL password for local development only
POSTGRES_PASSWORD=change-me

# Database hostname inside Docker Compose
POSTGRES_HOST=db

# PostgreSQL default port
POSTGRES_PORT=5432

# Django secret key for development only
DJANGO_SECRET_KEY=change-me

# Enable Django debug mode locally
DJANGO_DEBUG=True

# Cookie security flags should be True behind HTTPS in production
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Hosts allowed to access Django locally and from Docker Compose
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,digi2-backend

# Browser-facing API URL for local dev.
# In production behind Nginx, omit this so the frontend uses same-origin /api.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API URL used by Next.js inside Docker Compose
INTERNAL_API_URL=http://backend:8000

# Frontend origins allowed to call the Django API from browsers
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted origins for unsafe HTTP methods when CSRF applies
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS region for later stages
AWS_REGION=us-east-1

# Grafana SMTP Password
GF_SMTP_PASSWORD=<gmail-app-password>
